<?xml version="1.0" encoding="UTF-8"?>
<Installer>
    <Name>yauml</Name>
    <Version>{{PRODUCT_VERSION}}</Version>
    <Title>yauml Setup</Title>
    <Publisher>yauml project</Publisher>
    <ProductUrl>https://github.com/uafUa/yauml</ProductUrl>
    <StartMenuDir>yauml</StartMenuDir>
    <TargetDir>@ApplicationsDirX64@/yauml</TargetDir>
    <InstallerApplicationIcon>yaml-icon</InstallerApplicationIcon>
    <InstallerWindowIcon>yaml-icon.png</InstallerWindowIcon>
    <MaintenanceToolName>maintenancetool</MaintenanceToolName>
    <ControlScript>controlscript.qs</ControlScript>
    <RunProgram>@TargetDir@/yauml.exe</RunProgram>
    <RunProgramDescription>Start yauml</RunProgramDescription>
    <AllowNonAsciiCharacters>true</AllowNonAsciiCharacters>
    <AllowRepositoriesForOfflineInstaller>false</AllowRepositoriesForOfflineInstaller>
    <RemoteRepositories>
        <Repository>
            <Url>{{UPDATE_REPOSITORY_URL}}</Url>
            <Enabled>1</Enabled>
            <DisplayName>yauml stable updates</DisplayName>
        </Repository>
    </RemoteRepositories>
    <SupportsModify>false</SupportsModify>
    <RemoveTargetDir>true</RemoveTargetDir>
</Installer>
